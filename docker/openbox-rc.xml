<?xml version="1.0" encoding="UTF-8"?>
<!-- Okna bez ramek systemowych, a okno główne na całym ekranie: program wygląda jak strona. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <applications>
    <application class="*">
      <decor>no</decor>
    </application>
    <application title="Kompresja danych RLE">
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
